{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "baseUrl": "app",
    "paths": {
      "@/*": ["*"],
      "@pages/*": ["pages/*"],
      "@components/*": ["components/*"],
      "@queries/*": ["queries/*"],
      "@hooks/*": ["hooks/*"],
      "@utils/*": ["utils/*"],
      "@constants/*": ["constants/*"]
    }
  },
  "include": ["main.tsx", "app/**/*"],
  "exclude": ["node_modules", "dist"]
}
